# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Polar.sh checkout & public license verification (works 100% on 0 CZK GitHub Pages static hosting!)
CHECKOUT_URL=""
VITE_CHECKOUT_URL=""
POLAR_ORGANIZATION_ID=""
VITE_POLAR_ORGANIZATION_ID=""
# Optional: set to "true" only when testing against sandbox.polar.sh
POLAR_SANDBOX="false"
VITE_POLAR_SANDBOX="false"

# PRO_LICENSE_KEYS: Optional comma-separated list of server-verified PRO license keys.
# Note: Self-contained signed keys (format HZ-V4-XXXX-XXXX-CCCC) and Polar.sh keys work 100% without a backend server.
PRO_LICENSE_KEYS=""

# Optional legacy Lemon Squeezy verification
LEMONSQUEEZY_ENABLED="false"

# Optional legal & support contact metadata displayed in the Licence & PRO legal section (CZ/EU)
SUPPORT_EMAIL=""
OPERATOR_NAME=""
OPERATOR_ICO=""
OPERATOR_ADDRESS=""

# Static hosting equivalents (used when deployed to GitHub Pages / Cloudflare Pages without a Node server)
VITE_SUPPORT_EMAIL=""
VITE_OPERATOR_NAME=""
VITE_OPERATOR_ICO=""
VITE_OPERATOR_ADDRESS=""
