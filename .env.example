# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server-side or static (VITE_*) configuration for 0 CZK static hosting (GitHub Pages / Cloudflare Pages)
CHECKOUT_URL=""
VITE_CHECKOUT_URL=""

# PRO_LICENSE_KEYS: Optional comma-separated list of server-verified PRO license keys.
# Note: Self-contained signed keys (format HZ-V4-XXXX-XXXX-CCCC) and Lemon Squeezy keys also work 100% without a backend server.
PRO_LICENSE_KEYS=""

# LEMONSQUEEZY_ENABLED: Set to "true" to validate purchased keys against Lemon Squeezy License API on the server.
# (When hosted as a static site without a backend, the client automatically verifies directly against Lemon Squeezy's public license endpoint.)
LEMONSQUEEZY_ENABLED="false"

# Optional legal & support contact metadata displayed in the Licence & PRO legal section (CZ/EU)
SUPPORT_EMAIL=""
OPERATOR_NAME=""
OPERATOR_ICO=""
OPERATOR_ADDRESS=""

# Static hosting equivalents (used when deployed to GitHub Pages / Cloudflare Pages without a Node server)
VITE_SUPPORT_EMAIL=""
VITE_OPERATOR_NAME=""
VITE_OPERATOR_ICO=""
VITE_OPERATOR_ADDRESS=""
